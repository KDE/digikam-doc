msgstr ""
"См. описание модулей экспорта в разделе :ref:`Главное окно "
"<menu_mainexport>`."

#: ../../menu_descriptions/menu_lighttable.rst:140
msgid "The Settings Menu"
msgstr "Меню «Настройка»"

#: ../../menu_descriptions/menu_lighttable.rst:142
msgid "See description in the :ref:`Main Window <menu_mainsettings>` section."
msgstr "См. описание в разделе :ref:`Главное окно <menu_mainsettings>`."

#: ../../menu_descriptions/menu_lighttable.rst:145
msgid "The Help Menu"
msgstr "Меню «Справка»"

#: ../../menu_descriptions/menu_lighttable.rst:147
