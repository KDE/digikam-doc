#: ../../main_window/image_view.rst:204
msgid "#[options,start,step]"
msgstr "#[options,start,step]"

#: ../../main_window/image_view.rst:204
msgid "Sequence number (custom start and step)"
msgstr "Порядковый номер (настраиваемые начало и шаг)"

#: ../../main_window/image_view.rst:205
