#: ../../left_sidebar/mapsearch_view.rst:-1
msgid "digiKam Main Window Map Search View"
msgstr "Просмотр поиска на карте в главном окне digiKam"

#: ../../left_sidebar/mapsearch_view.rst:-1
msgid ""
"digiKam, documentation, user manual, photo management, open source, free, "
"learn, easy, map, search, geolocation"
msgstr ""
"digiKam, документация, руководство пользователя, управление фотографиями, "
"открытый исходный код, свободное ПО, обучение, просто, карта, поиск, "
"геолокация"

#: ../../left_sidebar/mapsearch_view.rst:14
msgid ":ref:`Map Search View <left_sidebar>`"
msgstr ":ref:`Просмотр поиска на карте <left_sidebar>`"

#: ../../left_sidebar/mapsearch_view.rst:16
