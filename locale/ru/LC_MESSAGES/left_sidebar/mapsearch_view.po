msgstr "Увеличить масштаб"

#: ../../left_sidebar/mapsearch_view.rst:19
msgid "zoom_out"
msgstr "Уменьшить масштаб"

#: ../../left_sidebar/mapsearch_view.rst:22
msgid "rectangle_select"
msgstr "Выделение прямоугольной области"

#: ../../left_sidebar/mapsearch_view.rst:25
msgid "region_from_thumbnail"
msgstr "Область из миниатюры"

#: ../../left_sidebar/mapsearch_view.rst:28
msgid "remove_region"
msgstr "Удалить область"

#: ../../left_sidebar/mapsearch_view.rst:31
msgid "filter_images"
msgstr "Фильтрация изображений"

#: ../../left_sidebar/mapsearch_view.rst:34
msgid "select_images"
msgstr "Выбрать изображения"

#: ../../left_sidebar/mapsearch_view.rst:37
