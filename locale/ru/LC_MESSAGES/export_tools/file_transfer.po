#: ../../export_tools/file_transfer.rst:-1
msgid "digiKam Export to Remote Computer"
msgstr "Экспорт из digiKam на удалённый компьютер"

#: ../../export_tools/file_transfer.rst:-1
msgid ""
"digiKam, documentation, user manual, photo management, open source, free, "
"learn, easy, remote, computer, export"
msgstr ""
"digiKam, документация, руководство пользователя, управление фотографиями, "
"открытый исходный код, свободное ПО, обучение, просто, удалённый, компьютер, "
