#: ../../post_processing/metadata_editor.rst:-1
msgid "The digiKam Metadata Editor"
msgstr "Редактор метаданных digiKam"

#: ../../post_processing/metadata_editor.rst:-1
msgid ""
"digiKam, documentation, user manual, photo management, open source, free, "
"learn, easy, metadata, editor, Exif, IPTC, XMP"
msgstr ""
"digiKam, документация, руководство пользователя, управление фотографиями, "
"открытый исходный код, свободное ПО, обучение, просто, метаданные, редактор, "
