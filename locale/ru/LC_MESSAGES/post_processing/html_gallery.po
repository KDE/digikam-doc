msgid "i18nexifimageyresolution (\"Image Y Resolution\")"
msgstr "i18nexifimageyresolution («Разрешение по Y»)"

#: ../../post_processing/html_gallery.rst:292
msgid "i18nexifimageresolutionunit (\"Image Resolution Unit\")"
msgstr "i18nexifimageresolutionunit («Единица разрешения»)"

