#: ../../setup_application/collections_settings.rst:-1
msgid ""
"digiKam, documentation, user manual, photo management, open source, free, "
"learn, easy, collection, setup, configure"
msgstr ""
"digiKam, документация, руководство пользователя, управление фотографиями, "
"открытый исходный код, свободное ПО, изучение, простота, коллекция, "
